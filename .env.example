# Supabase (public — browser) — только корень: https://xxxx.supabase.co (без /rest/v1/)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: auth redirect for local dev
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=

# App base URL (used for YooKassa return_url), no trailing slash
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase service role — server only (API routes, webhooks). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# YooKassa API (Basic Auth: shopId + secret)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Optional: npm run create-dev-admin (defaults if unset — see README)
# DEV_ADMIN_EMAIL=
# DEV_ADMIN_PASSWORD=
