# Supabase (public — browser) — только корень: https://xxxx.supabase.co (без /rest/v1/)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: auth redirect for local dev
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=

# App base URL (used for YooKassa return_url), no trailing slash
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: public contacts (PLACEHOLDER defaults in lib/site-config.ts)
# NEXT_PUBLIC_SITE_PHONE=+78120000000
# NEXT_PUBLIC_SITE_PHONE_DISPLAY=+7 (812) 000-00-00
# NEXT_PUBLIC_SITE_EMAIL=hello@pelikan-storage.ru

# Supabase service role — server only (API routes, webhooks). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# YooKassa API (Basic Auth: shopId + secret)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Optional: npm run create-dev-admin (defaults if unset — see README)
# DEV_ADMIN_EMAIL=
# DEV_ADMIN_PASSWORD=

# Optional: contract PDF site fields (defaults in lib/company-public.json)
# CONTRACT_PREMISES_ADDRESS=
# CONTRACT_CADASTRAL_NUMBER=78:07:000018:2133
# CONTRACT_COMPANY_OGRNIP=323784700287731
# CONTRACT_COMPANY_ADDRESS=
